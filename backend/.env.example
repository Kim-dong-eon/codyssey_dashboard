# MySQL example. Set this to the database URL supplied by your host.
DATABASE_URL=mysql+pymysql://user:password@host:3306/codyssey

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# APScheduler is disabled automatically on Vercel unless explicitly enabled.
ENABLE_SCHEDULER=false

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-secret

# Crawler credentials required for the scheduled route.
CODYSSEY_ID=
CODYSSEY_PW=
